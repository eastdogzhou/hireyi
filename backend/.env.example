# ==================== Application Configuration ====================
# Environment: development, staging, production
ENVIRONMENT=development

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Application secret key (generate with: openssl rand -hex 32)
SECRET_KEY=your-secret-key-here


# ==================== Supabase Configuration ====================
# Get these from: https://app.supabase.com/project/_/settings/api

# Supabase project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anonymous (public) key - safe for client use
SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service role key - NEVER expose to client, server-only
# This key bypasses Row Level Security (RLS)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here


# ==================== LLM Configuration ====================
# Default model for resume parsing and matching
# Options: gpt-4o, gpt-4-turbo, gpt-3.5-turbo, deepseek/deepseek-chat, etc.
DEFAULT_LLM_MODEL=gpt-4o

# LLM temperature (0.0-2.0, lower = more deterministic)
LLM_TEMPERATURE=0.3

# Maximum tokens for LLM responses
LLM_MAX_TOKENS=2000

# Timeout for LLM requests (seconds)
LLM_TIMEOUT=60

# OpenAI API Key (if using OpenAI models directly)
OPENAI_API_KEY=your-openai-api-key-here

# Alternative: OpenRouter API Key (recommended for unified access to 100+ LLMs)
# Get your key at: https://openrouter.ai/keys
# Use model format: openrouter/<provider>/<model> (e.g., openrouter/openai/gpt-4o)
# OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key-here

# Alternative: DeepSeek API Key (if using DeepSeek models)
# DEEPSEEK_API_KEY=your-deepseek-api-key-here

# Alternative: Other LLM provider keys as needed
# ANTHROPIC_API_KEY=your-anthropic-key
# GEMINI_API_KEY=your-gemini-key


# ==================== PyMuPDF Configuration ====================
# Text extraction strategy: text, blocks, words
PYMUPDF_TEXT_PAGE_STRATEGY=text

# Optional page limit for very large PDFs (leave empty for all pages)
# PYMUPDF_LOAD_PAGE_LIMIT=50

# PyMuPDF parsing timeout (seconds)
PYMUPDF_TIMEOUT=120


# ==================== File Storage Configuration ====================
# Using Aliyun OSS for resume storage

# Aliyun OSS access credentials
ALIYUN_OSS_ACCESS_KEY_ID=your-oss-access-key-id
ALIYUN_OSS_ACCESS_KEY_SECRET=your-oss-access-key-secret

# Aliyun OSS endpoint (MUST include https:// prefix)
# Examples: https://oss-cn-hangzhou.aliyuncs.com, https://oss-cn-shanghai.aliyuncs.com
ALIYUN_OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com

# Aliyun OSS bucket name
ALIYUN_OSS_BUCKET=your-bucket-name

# OSS base path for resume files (optional, e.g., "resumes/")
ALIYUN_OSS_BASE_PATH=resumes/

# Enable public read access (true for MVP, false for production)
ALIYUN_OSS_PUBLIC_READ=true


# ==================== Retry & Resilience ====================
# Maximum retry attempts for AI service calls
AI_MAX_RETRIES=3

# Exponential backoff base delay (seconds)
AI_RETRY_BASE_DELAY=1

# Maximum backoff delay (seconds)
AI_RETRY_MAX_DELAY=60


# ==================== Performance Configuration ====================
# Maximum concurrent resume parsing tasks
MAX_CONCURRENT_PARSE=5

# Maximum concurrent candidate matching tasks
MAX_CONCURRENT_MATCH=10

# Redis cache configuration (optional, for future use)
# REDIS_URL=redis://localhost:6379/0
# CACHE_TTL=3600


# ==================== CORS Configuration ====================
# Allowed origins for CORS (JSON array format)
# Development example:
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
# Production example:
# CORS_ORIGINS=["https://your-frontend-domain.com"]

# Allow credentials in CORS
CORS_ALLOW_CREDENTIALS=true


# ==================== Development & Testing ====================
# Enable debug mode (DO NOT use in production)
DEBUG=false

# Test database URL (optional, for integration tests)
# TEST_DATABASE_URL=postgresql://user:pass@localhost/test_db

# Mock AI responses in tests (true/false)
MOCK_AI_IN_TESTS=true


# ==================== Monitoring & Logging ====================
# Sentry DSN for error tracking (optional)
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Enable performance monitoring
# ENABLE_PERFORMANCE_MONITORING=true

# Log format: json, text
LOG_FORMAT=text

# Log to file path (optional)
# LOG_FILE_PATH=/var/log/hireyi/app.log
