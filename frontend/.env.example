# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Backend API
VITE_API_URL=http://localhost:8000
VITE_API_TIMEOUT=30000

# Aliyun OSS Configuration (for file upload)
VITE_OSS_REGION=oss-cn-hangzhou
VITE_OSS_BUCKET=resume-screening
VITE_OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com

# Feature Flags
VITE_ENABLE_AI_FEATURES=true
VITE_ENABLE_BATCH_UPLOAD=true
VITE_ENABLE_EXPORT=true
VITE_ENABLE_SMART_SCREENING=true

# Application Settings
VITE_MAX_FILE_SIZE=10485760
VITE_ALLOWED_FILE_TYPES=.pdf,.doc,.docx
VITE_PAGE_SIZE=20

# Development
VITE_LOG_LEVEL=debug
VITE_ENABLE_DEVTOOLS=true